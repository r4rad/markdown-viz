# Local / Cloud Run env placeholders — do not commit real secrets.
PORT=8081

# stub | verify (verify requires credentials outside the repo)
FIREBASE_AUTH_MODE=stub
FIREBASE_PROJECT_ID=

# Redis / Memorystore for multi-instance Yjs sync.
# Leave unset for single-instance local/CI (in-process rooms only).
# Local: redis://127.0.0.1:6379
# Memorystore: redis://10.x.x.x:6379 (VPC / Cloud Run)
# REDIS_URL=redis://127.0.0.1:6379

# Path to a service account JSON mounted at runtime (Secret Manager / Cloud Run).
# Never commit this file or put its contents in VITE_* vars.
# GOOGLE_APPLICATION_CREDENTIALS=
