# Local / Cloud Run env placeholders — do not commit real secrets.
PORT=8080

# stub | verify (verify requires credentials outside the repo)
FIREBASE_AUTH_MODE=stub
FIREBASE_PROJECT_ID=

# Path to a service account JSON mounted at runtime (Secret Manager / Cloud Run).
# Never commit this file or put its contents in VITE_* vars.
# GOOGLE_APPLICATION_CREDENTIALS=

# GitHub App (Cloud Run / Secret Manager only — never VITE_*).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=

# SyncJob quiet period (ms) before Cloud Tasks runs the GitHub commit. Default 30000.
# SYNC_QUIET_PERIOD_MS=30000

# Shared secret for Cloud Tasks → POST /v1/internal/sync/run (optional in local stub).
# SYNC_TASKS_SECRET=
